    background-color: #3b82f6;
    border-radius: 6px;
}
QPlainTextEdit {
    background-color: #080b10;
    color: #cbd5e1;
    border: 1px solid #1e2636;
    border-radius: 10px;
    font-family: "JetBrainsMono Nerd Font", monospace;
    font-size: 11px;
    padding: 8px;
