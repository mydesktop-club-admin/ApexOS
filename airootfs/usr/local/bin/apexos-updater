#!/usr/bin/env python3
"""
ApexOS Update Center — Zero-Terminal System & App Updater
Runs safe system updates (pacman + keyrings + Flatpak) via pkexec with a clean UI.
"""

import os
import shutil
import subprocess
import sys

from PyQt6.QtCore import QProcess, Qt
from PyQt6.QtGui import QIcon
from PyQt6.QtWidgets import (
    QApplication,
    QFrame,
    QHBoxLayout,
    QLabel,
    QMainWindow,
    QPlainTextEdit,
    QProgressBar,
    QPushButton,
    QVBoxLayout,
    QWidget,
)

STYLE = """
QMainWindow, QWidget {
    background-color: #0b0e14;
    color: #f1f5f9;
    font-family: "Noto Sans", "DejaVu Sans", sans-serif;
    font-size: 13px;
}
QFrame#Card {
    background-color: #131823;
    border: 1px solid #242d3f;
    border-radius: 14px;
}
QLabel#Title {
    font-size: 22px;
    font-weight: 700;
    color: #ffffff;
}
QLabel#Subtitle {
    font-size: 13px;
    color: #94a3b8;
}
QLabel#StatusHeading {
    font-size: 16px;
    font-weight: 600;
    color: #f8fafc;
}
QPushButton {
    background-color: #1e2636;
    color: #f1f5f9;
    border: 1px solid #2f3b52;
    border-radius: 9px;
    padding: 10px 18px;
    font-weight: 600;
}
