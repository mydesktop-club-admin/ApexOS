#!/usr/bin/env bash
# ==============================================================================
# ApexOS 1-Click Desktop Layout Switcher
# Usage:
#   apexos-layout-switcher win11       # Docked (non-floating) left-aligned taskbar (ApexOS Default)
#   apexos-layout-switcher default     # Alias for win11 (non-floating left-aligned taskbar)
#   apexos-layout-switcher signature   # Glass Top Bar + Centered Floating Bottom Dock
#   apexos-layout-switcher status      # Prints current active layout ID
# ==============================================================================
set -euo pipefail

MODE="${1:-status}"
CONF_DIR="${HOME}/.config"
APPLETS_RC="${CONF_DIR}/plasma-org.kde.plasma.desktop-appletsrc"
BACKUP_SIG="${CONF_DIR}/apexos-layout-signature.rc"
STATE_FILE="${CONF_DIR}/apexos-layout.state"
LAUNCHER_ICON="/usr/share/pixmaps/apexos-launcher-white.svg"
[[ ! -f "${LAUNCHER_ICON}" ]] && LAUNCHER_ICON="start-here-kde"

# Auto-detect exact installed .desktop filename for ProtonVPN (fallback to Arch default)
PROTONVPN_DESKTOP="proton.vpn.app.gtk.desktop"
for candidate in \
  /usr/share/applications/proton.vpn.app.gtk.desktop \
  /usr/share/applications/protonvpn-app.desktop \
  /usr/share/applications/*proton*vpn*.desktop; do
  if [[ -f "${candidate}" ]]; then
    PROTONVPN_DESKTOP="$(basename "${candidate}")"
    break
  fi
done

mkdir -p "${CONF_DIR}"

run_plasma_js() {
  local js="$1"
  local qdbus_bin
  qdbus_bin="$(command -v qdbus6 || command -v qdbus || true)"
  if [[ -n "${qdbus_bin}" ]]; then
    "${qdbus_bin}" org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "${js}"
  else
    dbus-send --session --dest=org.kde.plasmashell --type=method_call \
      /PlasmaShell org.kde.PlasmaShell.evaluateScript "string:${js}"
  fi
}

case "${MODE}" in
  status)
    if [[ -f "${STATE_FILE}" ]]; then
      cat "${STATE_FILE}"
    else
      echo "win11"
    fi
    ;;

  win11|default)
    if [[ ! -f "${BACKUP_SIG}" && -f "${APPLETS_RC}" ]]; then
      cp -f "${APPLETS_RC}" "${BACKUP_SIG}"
    fi

    TASKBAR_JS="
var allPanels = panels();
for (var i = 0; i < allPanels.length; i++) {
  allPanels[i].remove();
}

var panel = new Panel();
panel.location = 'bottom';
panel.height = 44;
panel.floating = false;
panel.alignment = 'left';
panel.hiding = 'none';

// Application Launcher + Icon-Only Task Manager aligned cleanly to the LEFT
var kickoff = panel.addWidget('org.kde.plasma.kickoff');
kickoff.currentConfigGroup = ['General'];
kickoff.writeConfig('icon', '${LAUNCHER_ICON}');
kickoff.writeConfig('favorites', [
  'org.kde.dolphin.desktop',
  'brave-browser.desktop',
  'steam.desktop',
  'gimp.desktop',
  'org.kde.krita.desktop',
  'vlc.desktop',
  'org.kde.discover.desktop',
  'systemsettings.desktop',
  'org.kde.konsole.desktop',
  'apexos-welcome.desktop',
  '${PROTONVPN_DESKTOP}',
  'mydesktop-club.desktop',
  'apexos-updater.desktop',
  'system-config-printer.desktop'
]);
kickoff.writeConfig('favoritesPortedToKAstats', false);

var tasks = panel.addWidget('org.kde.plasma.icontasks');
tasks.currentConfigGroup = ['General'];
tasks.writeConfig('launchers', [
  'applications:org.kde.dolphin.desktop',
  'applications:brave-browser.desktop',
  'applications:steam.desktop',
  'applications:gimp.desktop',
  'applications:org.kde.krita.desktop',
  'applications:vlc.desktop',
  'applications:org.kde.discover.desktop',
  'applications:systemsettings.desktop'
]);
tasks.writeConfig('groupingStrategy', '1');
tasks.writeConfig('indicateAudioStreams', 'true');

// Expanding spacer pushes System Tray, Clock & Show Desktop to the right edge
panel.addWidget('org.kde.plasma.panelspacer');

panel.addWidget('org.kde.plasma.systemtray');

var clock = panel.addWidget('org.kde.plasma.digitalclock');
clock.currentConfigGroup = ['Appearance'];
clock.writeConfig('showDate', 'true');
clock.writeConfig('dateFormat', 'shortDate');

panel.addWidget('org.kde.plasma.showdesktop');
"
    run_plasma_js "${TASKBAR_JS}"
    echo "win11" > "${STATE_FILE}"
    echo "Applied docked left-aligned ApexOS taskbar."
    ;;

  signature)
    RESTORE_SRC=""
    if [[ -f "${BACKUP_SIG}" ]]; then
      RESTORE_SRC="${BACKUP_SIG}"
    fi

    if [[ -n "${RESTORE_SRC}" ]]; then
      cp -f "${RESTORE_SRC}" "${APPLETS_RC}"
      if command -v kquitapp6 >/dev/null 2>&1; then
        kquitapp6 plasmashell >/dev/null 2>&1 || true
      else
        pkill -x plasmashell >/dev/null 2>&1 || true
      fi
      sleep 1
      setsid plasmashell --replace >/dev/null 2>&1 &
    else
      SIG_JS="
var allPanels = panels();
for (var i = 0; i < allPanels.length; i++) {
  allPanels[i].remove();
}

var topBar = new Panel();
topBar.location = 'top';
topBar.height = 30;
topBar.floating = false;

var kickoff = topBar.addWidget('org.kde.plasma.kickoff');
kickoff.currentConfigGroup = ['General'];
kickoff.writeConfig('icon', '${LAUNCHER_ICON}');
kickoff.writeConfig('favorites', [
  'org.kde.dolphin.desktop',
  'brave-browser.desktop',
  'steam.desktop',
  'gimp.desktop',
  'org.kde.krita.desktop',
  'vlc.desktop',
  'org.kde.discover.desktop',
  'systemsettings.desktop',
  'org.kde.konsole.desktop',
  'apexos-welcome.desktop',
  '${PROTONVPN_DESKTOP}',
  'mydesktop-club.desktop',
  'apexos-updater.desktop',
  'system-config-printer.desktop'
]);
kickoff.writeConfig('favoritesPortedToKAstats', false);

topBar.addWidget('org.kde.plasma.appmenu');
topBar.addWidget('org.kde.plasma.panelspacer');
topBar.addWidget('org.kde.plasma.systemtray');
topBar.addWidget('org.kde.plasma.digitalclock');

var dock = new Panel();
dock.location = 'bottom';
dock.height = 54;
dock.floating = true;
dock.alignment = 'center';
dock.lengthMode = 'fit';

var tasks = dock.addWidget('org.kde.plasma.icontasks');
tasks.currentConfigGroup = ['General'];
tasks.writeConfig('launchers', [
  'applications:org.kde.dolphin.desktop',
  'applications:brave-browser.desktop',
  'applications:steam.desktop',
  'applications:gimp.desktop',
  'applications:org.kde.krita.desktop',
  'applications:vlc.desktop',
  'applications:org.kde.discover.desktop',
  'applications:systemsettings.desktop'
]);
dock.addWidget('org.kde.plasma.trash');
"
      run_plasma_js "${SIG_JS}"
    fi
    echo "signature" > "${STATE_FILE}"
    echo "Applied ApexOS Signature Glass Dock layout."
    ;;

  *)
    echo "Usage: apexos-layout-switcher [win11|default|signature|status]" >&2
    exit 1
    ;;
esac
