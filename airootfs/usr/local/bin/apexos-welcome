def get_hardware_summary() -> str:
    cpu = "Unknown CPU"
    try:
        with open("/proc/cpuinfo", "r", encoding="utf-8") as fh:
            for line in fh:
                if line.startswith("model name"):
                    cpu = line.split(":", 1)[1].strip()
                    break
    except OSError:
        pass

    mem_gb = "?"
    try:
        with open("/proc/meminfo", "r", encoding="utf-8") as fh:
            for line in fh:
                if line.startswith("MemTotal:"):
                    kb = int(line.split()[1])
                    mem_gb = f"{round(kb / (1024 * 1024))} GB RAM"
                    break
    except (OSError, ValueError):
        pass

    gpu = ""
    if shutil.which("nvidia-smi"):
        try:
            out = subprocess.check_output(
                ["nvidia-smi", "--query-gpu=name", "--format=csv,noheader"],
                text=True,
                timeout=2,
            ).strip()
            if out:
                gpu = out.splitlines()[0]
        except Exception:
            pass

    kernel = platform.release()
    parts = [cpu, mem_gb]
    if gpu:
        parts.append(gpu)
    parts.append(f"Kernel {kernel}")
    return "  •  ".join(parts)


def get_installed_flatpaks() -> set[str]:
    if not shutil.which("flatpak"):
        return set()
    try:
        out = subprocess.check_output(
            ["flatpak", "list", "--app", "--columns=application"],
            text=True,
            stderr=subprocess.DEVNULL,
            timeout=5,
        )
        return {line.strip() for line in out.splitlines() if line.strip()}
    except Exception:
        return set()


def launch_detached(cmd: list[str]) -> None:
    if cmd and shutil.which(cmd[0]):
        subprocess.Popen(
            cmd,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )


class ApexWelcomeWindow(QMainWindow):
    def __init__(self) -> None:
        super().__init__()
        self.setWindowTitle("ApexOS Welcome & Control Center")
        self.setMinimumSize(940, 620)
        icon_path = "/usr/share/pixmaps/apexos-launcher-white.svg"
        if os.path.exists(icon_path):
            self.setWindowIcon(QIcon(icon_path))

        self.app_buttons: dict[str, QPushButton] = {}
        self.flatpak_proc = QProcess(self)
        self.flatpak_proc.setProcessChannelMode(
            QProcess.ProcessChannelMode.MergedChannels
        )
        self.flatpak_proc.finished.connect(self._on_flatpak_finished)
        self.active_app_id = ""
        self.active_app_action = ""

        self._build_ui()
        self.setStyleSheet(STYLE)
        self._refresh_layout_status()
        self._refresh_flatpak_buttons()

    def _build_ui(self) -> None:
        root = QWidget()
        outer = QHBoxLayout(root)
        outer.setContentsMargins(0, 0, 0, 0)
        outer.setSpacing(0)

        # Sidebar
        sidebar = QFrame()
        sidebar.setObjectName("Sidebar")
        sidebar.setFixedWidth(230)
        sb_layout = QVBoxLayout(sidebar)
        sb_layout.setContentsMargins(16, 20, 16, 16)
        sb_layout.setSpacing(12)

        brand = QLabel("ApexOS")
        brand.setObjectName("BrandTitle")
        tagline = QLabel("Fast. Familiar. Zero Terminal.")
        tagline.setObjectName("Muted")
        sb_layout.addWidget(brand)
        sb_layout.addWidget(tagline)

        self.nav = QListWidget()
        self.nav.setObjectName("NavList")
        for label in [
            "Home & Quick Start",
            "Desktop Layout",
            "Popular Apps",
            "System & Safety",
            "Windows Shortcuts",
        ]:
            self.nav.addItem(QListWidgetItem(label))
        self.nav.setCurrentRow(0)
        self.nav.currentRowChanged.connect(self._on_nav_changed)
        sb_layout.addWidget(self.nav, stretch=1)

        self.startup_chk = QCheckBox("Show on startup")
        self.startup_chk.setChecked(AUTOSTART_FILE.exists())
        self.startup_chk.toggled.connect(self._toggle_autostart)
        sb_layout.addWidget(self.startup_chk)

        outer.addWidget(sidebar)

        # Main stacked pages
        self.pages = QStackedWidget()
        self.pages.addWidget(self._build_home_page())
        self.pages.addWidget(self._build_layout_page())
        self.pages.addWidget(self._build_apps_page())
        self.pages.addWidget(self._build_system_page())
        self.pages.addWidget(self._build_shortcuts_page())

        outer.addWidget(self.pages, stretch=1)
        self.setCentralWidget(root)

    def _on_nav_changed(self, idx: int) -> None:
        self.pages.setCurrentIndex(idx)
        if idx == 1:
            self._refresh_layout_status()
        elif idx == 2:
            self._refresh_flatpak_buttons()

    def _toggle_autostart(self, enabled: bool) -> None:
        if enabled:
            AUTOSTART_FILE.parent.mkdir(parents=True, exist_ok=True)
            src = Path("/usr/share/applications/apexos-welcome.desktop")
            if src.exists():
                shutil.copyfile(src, AUTOSTART_FILE)
        else:
            if AUTOSTART_FILE.exists():
                AUTOSTART_FILE.unlink()

    def _make_card(
        self, title: str, desc: str, btn_text: str, callback, primary: bool = False
    ) -> QFrame:
        card = QFrame()
        card.setObjectName("Card")
        lay = QVBoxLayout(card)
        lay.setContentsMargins(18, 16, 18, 16)
        lay.setSpacing(8)
        t = QLabel(title)
        t.setObjectName("CardTitle")
        d = QLabel(desc)
        d.setObjectName("Muted")
        d.setWordWrap(True)
        btn = QPushButton(btn_text)
        if primary:
            btn.setObjectName("Primary")
        btn.clicked.connect(callback)
        lay.addWidget(t)
        lay.addWidget(d)
        lay.addStretch()
        lay.addWidget(btn, alignment=Qt.AlignmentFlag.AlignLeft)
        return card

