    def _refresh_layout_status(self) -> None:
        try:
            mode = subprocess.check_output(
                ["/usr/local/bin/apexos-layout-switcher", "status"], text=True
            ).strip()
        except Exception:
            mode = "signature"
        label = (
            "ACTIVE LAYOUT: WINDOWS 11 CLASSIC"
            if mode == "win11"
            else "ACTIVE LAYOUT: APEXOS SIGNATURE GLASS"
        )
        self.layout_status_lbl.setText(label)

    def _apply_layout(self, mode: str) -> None:
        self.layout_status_lbl.setText("APPLYING LAYOUT...")
        QApplication.processEvents()
        subprocess.run(
            ["/usr/local/bin/apexos-layout-switcher", mode],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        self._refresh_layout_status()

    # --- Page 2: 1-Click Popular Apps ---
    def _build_apps_page(self) -> QWidget:
        page = QWidget()
        lay = QVBoxLayout(page)
        lay.setContentsMargins(28, 24, 28, 20)
        lay.setSpacing(12)

        top_row = QHBoxLayout()
        header_col = QVBoxLayout()
        title = QLabel("Popular Apps — 1-Click Install & Remove")
        title.setObjectName("PageTitle")
        sub = QLabel(
            "Installed safely via Flathub (sandboxed apps that never break your system). Want more? Open the full App Store."
        )
        sub.setObjectName("Muted")
        header_col.addWidget(title)
        header_col.addWidget(sub)
        top_row.addLayout(header_col, stretch=1)

        store_btn = QPushButton("Full App Store (Discover)")
        store_btn.setObjectName("Primary")
        store_btn.clicked.connect(lambda: launch_detached(["plasma-discover"]))
        shelly_btn = QPushButton("Shelly (Arch/AUR)")
        shelly_btn.clicked.connect(lambda: launch_detached(["shelly"]))
        top_row.addWidget(store_btn)
        top_row.addWidget(shelly_btn)
        lay.addLayout(top_row)

        self.apps_status = QLabel("Ready — click Install or Uninstall on any app below.")
        self.apps_status.setObjectName("Muted")
        self.apps_progress = QProgressBar()
        self.apps_progress.setVisible(False)
        self.apps_progress.setTextVisible(False)
        lay.addWidget(self.apps_status)
        lay.addWidget(self.apps_progress)

        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        container = QWidget()
        cl = QVBoxLayout(container)
        cl.setContentsMargins(0, 4, 8, 8)
        cl.setSpacing(10)

        last_cat = None
        for cat, name, desc, app_id in POPULAR_APPS:
            if cat != last_cat:
                cat_lbl = QLabel(cat)
                cat_lbl.setObjectName("SectionLabel")
                cl.addWidget(cat_lbl)
                last_cat = cat

            row_card = QFrame()
            row_card.setObjectName("Card")
            rl = QHBoxLayout(row_card)
            rl.setContentsMargins(14, 10, 14, 10)

            info = QVBoxLayout()
            info.setSpacing(2)
            nl = QLabel(name)
            nl.setObjectName("CardTitle")
            dl = QLabel(desc)
            dl.setObjectName("Muted")
            dl.setWordWrap(True)
            info.addWidget(nl)
            info.addWidget(dl)

            btn = QPushButton("Install")
            btn.setFixedWidth(118)
            btn.clicked.connect(
                lambda _checked=False, aid=app_id, nm=name: self._toggle_flatpak(
                    aid, nm
                )
            )
            self.app_buttons[app_id] = btn

            rl.addLayout(info, stretch=1)
            rl.addWidget(btn)
            cl.addWidget(row_card)

        cl.addStretch()
        scroll.setWidget(container)
        lay.addWidget(scroll, stretch=1)
        return page

    def _refresh_flatpak_buttons(self) -> None:
        installed = get_installed_flatpaks()
        busy = self.flatpak_proc.state() != QProcess.ProcessState.NotRunning
        for _cat, _name, _desc, app_id in POPULAR_APPS:
            btn = self.app_buttons.get(app_id)
            if not btn:
                continue
            btn.setEnabled(not busy)
            if app_id in installed:
                btn.setText("Uninstall")
                btn.setObjectName("Danger")
            else:
                btn.setText("Install")
                btn.setObjectName("Primary")
            btn.style().unpolish(btn)
            btn.style().polish(btn)

    def _toggle_flatpak(self, app_id: str, name: str) -> None:
        if self.flatpak_proc.state() != QProcess.ProcessState.NotRunning:
            return
        if not shutil.which("flatpak"):
            self.apps_status.setText("Flatpak is not available on this system.")
            return

        installed = get_installed_flatpaks()
        self.active_app_id = app_id
        for b in self.app_buttons.values():
            b.setEnabled(False)
        self.apps_progress.setRange(0, 0)
        self.apps_progress.setVisible(True)

        # Ensure Flathub user remote exists before installing
        subprocess.run(
            [
                "flatpak",
                "remote-add",
                "--user",
                "--if-not-exists",
                "flathub",
                "https://dl.flathub.org/repo/flathub.flatpakrepo",
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )

        if app_id in installed:
            self.active_app_action = "remove"
            self.apps_status.setText(f"Removing {name}...")
            self.flatpak_proc.start(
                "flatpak", ["uninstall", "-y", "--noninteractive", app_id]
            )
        else:
            self.active_app_action = "install"
            self.apps_status.setText(
                f"Downloading and installing {name} (this may take a minute on first app)..."
            )
            self.flatpak_proc.start(
                "flatpak",
                ["install", "--user", "-y", "--noninteractive", "flathub", app_id],
            )

    def _on_flatpak_finished(
        self, exit_code: int, _exit_status: QProcess.ExitStatus
    ) -> None:
        self.apps_progress.setVisible(False)
        if exit_code == 0:
            verb = "Installed" if self.active_app_action == "install" else "Removed"
            self.apps_status.setText(f"{verb} successfully! Check your Start Menu.")
        else:
            self.apps_status.setText(
                "Could not complete the change — check your internet connection and try again."
            )
        self._refresh_flatpak_buttons()

    # --- Page 3: System & Safety ---
    def _build_system_page(self) -> QWidget:
        page = QWidget()
        lay = QVBoxLayout(page)
        lay.setContentsMargins(28, 26, 28, 26)
        lay.setSpacing(16)

        title = QLabel("System Maintenance & Hardware")
        title.setObjectName("PageTitle")
        sub = QLabel(
            "Graphical tools for updates, system restore points, printers, firewall security, and GPU controls."
        )
        sub.setObjectName("Muted")
        sub.setWordWrap(True)

        grid = QGridLayout()
        grid.setSpacing(14)
        grid.addWidget(
            self._make_card(
                "ApexOS Update Center",
                "One-click system, driver, and Flatpak updates without using a terminal.",
                "Open Updater",
                lambda: launch_detached(["/usr/local/bin/apexos-updater"]),
                primary=True,
            ),
            0,
            0,
        )
        grid.addWidget(
            self._make_card(
                "System Restore (Timeshift)",
                "Create automatic restore points before changes so you can roll back anytime.",
                "Open Timeshift",
                lambda: launch_detached(["timeshift-launcher"]),
            ),
            0,
            1,
        )
        grid.addWidget(
            self._make_card(
                "Printers & Scanners",
                "Add Wi-Fi or USB printers visually in seconds.",
                "Configure Printers",
                lambda: launch_detached(["system-config-printer"]),
            ),
            1,
            0,
        )
        grid.addWidget(
            self._make_card(
                "Firewall Protection",
                "Simple on/off switch and rules for network protection (like Windows Firewall).",
                "Open Firewall",
                lambda: launch_detached(["gufw"]),
            ),
            1,
            1,
        )
        grid.addWidget(
            self._make_card(
                "Task Manager",
                "Inspect CPU, GPU, memory usage, and close unresponsive apps.",
                "Open Task Manager",
                lambda: launch_detached(["plasma-systemmonitor"]),
            ),
            2,
            0,
        )
        grid.addWidget(
            self._make_card(
                "NVIDIA Graphics Settings",
                "Adjust display refresh rates, G-SYNC, and GPU performance profiles.",
                "Open NVIDIA Settings",
                lambda: launch_detached(["nvidia-settings"]),
            ),
            2,
            1,
        )

        lay.addWidget(title)
        lay.addWidget(sub)
        lay.addLayout(grid, stretch=1)
        return page

    # --- Page 4: Windows Shortcuts Cheat Sheet ---
    def _build_shortcuts_page(self) -> QWidget:
        page = QWidget()
        lay = QVBoxLayout(page)
        lay.setContentsMargins(28, 26, 28, 26)
        lay.setSpacing(14)

        title = QLabel("Windows 11 Shortcuts — Built Right In")
        title.setObjectName("PageTitle")
        sub = QLabel(
            "ApexOS pre-maps the keyboard shortcuts you already know from Windows so everything feels natural immediately."
        )
        sub.setObjectName("Muted")
        sub.setWordWrap(True)

        table = QTableWidget(len(SHORTCUTS), 2)
        table.setHorizontalHeaderLabels(["Shortcut", "Action in ApexOS"])
        table.verticalHeader().setVisible(False)
        table.setEditTriggers(QTableWidget.EditTrigger.NoEditTriggers)
        table.setSelectionMode(QTableWidget.SelectionMode.NoSelection)
        table.horizontalHeader().setStretchLastSection(True)
        table.setColumnWidth(0, 220)

        for idx, (keys, desc) in enumerate(SHORTCUTS):
            k_item = QTableWidgetItem(keys)
            k_item.setForeground(Qt.GlobalColor.cyan)
            d_item = QTableWidgetItem(desc)
            table.setItem(idx, 0, k_item)
            table.setItem(idx, 1, d_item)
            table.setRowHeight(idx, 36)

        lay.addWidget(title)
        lay.addWidget(sub)
        lay.addWidget(table, stretch=1)
        return page


def main() -> int:
    app = QApplication(sys.argv)
    app.setApplicationName("ApexOS Welcome")
    win = ApexWelcomeWindow()
    win.show()
    return app.exec()


if __name__ == "__main__":
    raise SystemExit(main())
