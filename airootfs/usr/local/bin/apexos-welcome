        sl.addWidget(st)
        sl.addWidget(sd)
        sl.addStretch()
        sl.addWidget(sbtn)

        row.addWidget(win_card)
        row.addWidget(sig_card)

        tip = QFrame()
        tip.setObjectName("Card")
