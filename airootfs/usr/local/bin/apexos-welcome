        sub.setObjectName("Muted")
        sub.setWordWrap(True)

        hw_card = QFrame()
        hw_card.setObjectName("CardHighlight")
        hw_lay = QVBoxLayout(hw_card)
        hw_lay.setContentsMargins(16, 12, 16, 12)
        hw_lbl = QLabel("THIS PC")
        hw_lbl.setObjectName("SectionLabel")
        hw_val = QLabel(get_hardware_summary())
        hw_val.setWordWrap(True)
        hw_lay.addWidget(hw_lbl)
        hw_lay.addWidget(hw_val)

        grid = QGridLayout()
        grid.setSpacing(14)
        grid.addWidget(
            self._make_card(
                "App Store (Discover)",
                "Browse, install, and uninstall thousands of apps & firmware updates with screenshots and 1-click buttons.",
                "Open App Store",
                lambda: launch_detached(["plasma-discover"]),
                primary=True,
            ),
            0,
            0,
        )
        grid.addWidget(
            self._make_card(
                "1-Click Popular Apps",
                "Install Discord, Spotify, Chrome, Heroic Games, OnlyOffice, OBS, and Bottles (for Windows .exe apps).",
                "Pick Popular Apps",
                lambda: self.nav.setCurrentRow(2),
            ),
            0,
            1,
        )
        grid.addWidget(
            self._make_card(
                "Desktop Layout",
                "Switch anytime between a familiar Windows 11 centered taskbar and the ApexOS Signature Glass Dock.",
                "Choose Layout",
                lambda: self.nav.setCurrentRow(1),
            ),
            1,
            0,
        )
        grid.addWidget(
            self._make_card(
                "ApexOS Update Center",
                "Keep your OS, NVIDIA drivers, and installed apps up to date safely with one click.",
                "Check for Updates",
                lambda: launch_detached(["/usr/local/bin/apexos-updater"]),
            ),
            1,
            1,
        )

        lay.addWidget(title)
        lay.addWidget(sub)
        lay.addWidget(hw_card)
        lay.addLayout(grid, stretch=1)
        return page

    # --- Page 1: Desktop Layout Switcher ---
    def _build_layout_page(self) -> QWidget:
        page = QWidget()
        lay = QVBoxLayout(page)
        lay.setContentsMargins(28, 26, 28, 26)
        lay.setSpacing(16)

        title = QLabel("Desktop Layout & Feel")
        title.setObjectName("PageTitle")
        sub = QLabel(
            "Choose the desktop layout that feels most natural to you. You can switch back and forth anytime without losing your apps or files."
        )
        sub.setObjectName("Muted")
        sub.setWordWrap(True)

        self.layout_status_lbl = QLabel("")
        self.layout_status_lbl.setObjectName("SectionLabel")

        row = QHBoxLayout()
        row.setSpacing(16)

        win_card = QFrame()
        win_card.setObjectName("Card")
        wl = QVBoxLayout(win_card)
        wl.setContentsMargins(20, 20, 20, 20)
        wl.setSpacing(10)
        wt = QLabel("Windows 11 Classic")
        wt.setObjectName("CardTitle")
        wd = QLabel(
            "• Single floating taskbar along the bottom\n"
