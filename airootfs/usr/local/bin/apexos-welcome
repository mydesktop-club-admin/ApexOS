        page = QWidget()
        lay = QVBoxLayout(page)
        lay.setContentsMargins(28, 26, 28, 26)
        lay.setSpacing(18)

        title = QLabel("Welcome to ApexOS")
        title.setObjectName("PageTitle")
        sub = QLabel(
