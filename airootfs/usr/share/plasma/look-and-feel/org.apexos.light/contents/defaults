[kdeglobals][KDE]
widgetStyle=Breeze
SingleClick=false

[kdeglobals][General]
ColorScheme=ApexOSLight

[kdeglobals][Icons]
Theme=breeze

[plasmarc][Theme]
name=ApexOSLight

[Wallpaper]
defaultWallpaperTheme=ApexOSLight
defaultFileSuffix=.jpg
defaultWidth=3840
defaultHeight=2160

